# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chat-app
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# Server Configuration
SERVER_PORT=8080
SERVER_CONTEXT_PATH=/api

# JWT Configuration
# Generate a real random secret, e.g. `openssl rand -base64 48` (minimum 32 bytes).
# The app refuses to start with the placeholder value below.
JWT_SECRET=change-this-to-a-secure-random-string-minimum-256-bits-required
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=1209600000
REFRESH_COOKIE_NAME=chat_refresh_token
REFRESH_COOKIE_PATH=/api/auth
# Set to true in production. Local HTTP development requires false.
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=Lax

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:4173,http://127.0.0.1:4173,http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_ALLOW_CREDENTIALS=true

# Application
# Local development uses dev defaults. Production MUST set `prod`: without the profile
# the app refuses to start against a non-local database (dev defaults skip Flyway and
# use ddl-auto=update).
SPRING_PROFILES_ACTIVE=dev
ADMIN_BOOTSTRAP_USERNAME=
AVATAR_UPLOAD_DIR=uploads/avatars
MEDIA_UPLOAD_DIR=uploads/media

# Auth rate limiting (in-memory fixed window, per IP and per account)
RATE_LIMIT_WINDOW_SECONDS=900
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_REFRESH_MAX=60
# Max members a user can invite (group creation + member adds) per rate-limit window.
RATE_LIMIT_ROOM_MEMBER_ADDS_MAX=100

# Cloudinary Media Upload
# Public delivery bypasses conversation access checks. Keep disabled for private chat media.
CLOUDINARY_PUBLIC_UPLOADS_ENABLED=false
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_FOLDER=chat-app/messages
# Formats Cloudinary may store when public uploads are on; HTML/SVG are intentionally blocked.
CLOUDINARY_ALLOWED_FORMATS=jpg,png,webp,gif,mp4,webm,mov,avi,mkv,mp3,ogg,wav,pdf,zip,doc,docx,xls,xlsx,ppt,pptx,txt,csv,json
# Max upload signatures issued per user per rolling 24h.
CLOUDINARY_DAILY_SIGNATURE_QUOTA=100
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
